# Ephemera environment variables
# Copy to .env (or .env.local for `npm run dev`) and adjust.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ephemera_dev

# --- Retention (optional) ---------------------------------------------------
# Days after a drop dies (expired/exhausted/revoked) before its ciphertext is
# blanked by the purge sweep. Default: 3
# RETENTION_DAYS=3

# Days to keep rows in the view log. Default: 30
# VIEWS_RETENTION_DAYS=30

# Minutes between purge sweeps. Default: 60
# PURGE_INTERVAL_MIN=60

# --- Docker compose (production stack) ---------------------------------------
# Used by docker-compose.yml when running the bundled database.
POSTGRES_USER=ephemera
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ephemera

# External port for the app container. Default: 3000
# HOST_PORT=3000

# Set to "true" to skip automatic migrations at container start.
# SKIP_MIGRATIONS=false
