# Ephemera Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration (Required)
# ===========================================
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/ephemera

# ===========================================
# Development Only (Not needed in production)
# ===========================================
# Dev admin credentials for /dev-login route
# These are only used when NODE_ENV !== "production"
DEV_ADMIN_USER=admin
DEV_ADMIN_PASS=admin

# ===========================================
# Docker Compose Variables
# ===========================================
# Used by docker-compose.production.yml
POSTGRES_USER=ephemera
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ephemera

# Port to expose (default: 3000)
PORT=3000

# ===========================================
# Optional: Skip Migrations
# ===========================================
# Set to "true" to skip automatic database migrations on startup
# SKIP_MIGRATIONS=false
